{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "learnJenkinsApp-TaskDefenition-Prod",
    "containerDefinitions": [
        {
            "name": "learn-jenkins-app",
            "image": "953907014716.dkr.ecr.us-east-1.amazonaws.com/learnjenkinsapp:#APP_VERSION#",
            "portMappings": [
                {
                    "name": "nginx-80-tip",
                    "hostPort": 80,
                    "containerPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::953907014716:role/ecsTaskExecutionRole"
}