pipeline {
    agent any

    stages {
        stage('Build Docker images') {
            steps {
                sh '''
            docker build -f ci/Dockerfile-playright -t myplayright .
            docker build -f ci/Dockerfile-aws-cli -t myaws .
        '''
            }
        }

        stage('Deploy to AWS') {
            agent {
                docker {
                    image 'amazon/aws-cli'
                    args '--entrypoint=""'
                    reuseNode true
                }
            }
        }
    }
}
